# Copy this file to .env and fill in. .env is git-ignored. Never paste keys in chat or code.

# MantaGO: botId is in the URL mantago.cc/chatbot/<botId>
# Token + secret: bot console > Settings > Advanced Settings > API Integration Settings > Refresh
MANTAGO_BOT_ID=
MANTAGO_TOKEN=
MANTAGO_SECRET=
MANTAGO_PLATFORM=whatsapp

# LLM: openrouter (free models, key from openrouter.ai/keys) | anthropic | openai | gemini
LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_MODEL=google/gemma-4-31b-it:free
