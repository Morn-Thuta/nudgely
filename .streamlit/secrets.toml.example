# Paste this (filled in) into Streamlit Cloud > App settings > Secrets.
# For local runs, copy to .streamlit/secrets.toml (git-ignored).

[mantago]
bot_id = ""
token = ""
secret = ""
platform = "whatsapp"

# Team phones that get a REAL message. Get clientIds with: python scripts/test_mantago.py members
[test_accounts]
# C001 = "<clientId>"
# C002 = "<clientId>"

# Approved WhatsApp templates = MantaGO message pack ids (from the pack's URL), per customer.
# WhatsApp only delivers business-initiated broadcasts from approved templates.
[whatsapp_templates]
# C001 = "<message pack id>"

[llm]
provider = ""
api_key = ""
model = ""
