# Public URL of this frontend, used for QR codes (optional; browser origin is the fallback)
NEXT_PUBLIC_SITE_URL=
# Only the public/publishable key belongs here. NEVER use a service role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-side proxy target, not exposed to the browser
NUDGELY_API_URL=https://nudgely-api.onrender.com
# live is the default. mock is an explicitly labelled offline rehearsal.
NUDGELY_CHAT_MODE=live
